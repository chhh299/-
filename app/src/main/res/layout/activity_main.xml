<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/service_status_disabled"
        android:textColor="@color/white"
        android:background="@color/status_red"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tv_tcp_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:text="TCP 状态: 未连接对端"
        android:textColor="@color/black"
        android:background="#E0E0E0"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_open_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_open_settings" />

    <!-- 动态配置对端服务器（PC 或 未来的 OpenWrt 路由器） -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="对端 MCP 服务器设置 (支持 PC 或 OpenWrt):"
        android:textStyle="bold"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <EditText
            android:id="@+id/et_target_ip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:hint="对端 IP 地址"
            android:text="192.168.193.51"
            android:textSize="13sp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/et_target_port"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="端口"
            android:text="19388"
            android:inputType="number"
            android:textSize="13sp"
            android:singleLine="true" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_save_connect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="保存配置并主动连接对端" />

    <Button
        android:id="@+id/btn_test_cmd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/btn_test_cmd" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/log_title"
        android:textStyle="bold"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="@color/bg_log"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待控制指令..."
            android:textColor="@color/black"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
